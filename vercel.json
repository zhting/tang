{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/machinarium",
      "destination": "/machinarium.html"
    },
    {
      "source": "/m9",
      "destination": "/machinarium.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
